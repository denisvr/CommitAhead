# Claude Code local state stays untracked, with one deliberate exception: the project-specific
# /devalente-e2e skill is version-controlled. Git cannot re-include a path inside an excluded
# directory, so each level is excluded and then re-opened just enough to descend to that one skill.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/devalente-e2e/

# .NET
bin/
obj/
*.user
.vs/

# Frontend
node_modules/
dist/
*.tsbuildinfo

# Published artifacts (dotnet publish output; wwwroot is copied in only here)
publish/
backend/**/wwwroot/

# Test results
[Tt]est[Rr]esult*/
*.trx

# Local secrets
.env
.env.production
!.env.example
!.env.production.example

# EF Core migration bundle (built on demand, never committed - see backend/scripts/build-migration-bundle.ps1)
backend/artifacts/

# Manual local-Docker DB backups (see backend/scripts/backup-production-db.ps1) - may contain real data
backend/backups/

# OS
.DS_Store
Thumbs.db
