POSTGRES_PASSWORD=local_dev_only_change_me
COMMITAHEAD_MIGRATOR_PASSWORD=local_dev_only_change_me
COMMITAHEAD_APP_PASSWORD=local_dev_only_change_me

# Only read by docker-compose.dev.yml's `api` container (README.md "Local Development (Fully
# Containerized, Hot-Reload)") — running the API directly on the host still uses
# `dotnet user-secrets` instead, per "Local Database (Development)" above. Optional: the app
# starts fine with these blank, exactly like an unconfigured host `dotnet run` — every
# Supabase/AI use case just fails closed with a clear error instead of a silent fallback.
SUPABASE_URL=
SUPABASE_ANON_KEY=
ANTHROPIC_API_KEY=
