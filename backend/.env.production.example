# Copy to backend/.env.production and set real values — never commit the copy (see .gitignore).
# Consumed by docker-compose.prod.yml (repo root) via `--env-file backend/.env.production`, and by
# backend/scripts/setup-production-db.ps1 for the roles/migrations/RLS bootstrap. Distinct from
# backend/.env (dev-only) so the two stacks never share credentials.

# Postgres superuser (docker-compose.prod.yml's db service) and the two dedicated login roles
# scripts/database/001_roles.sql creates — same three variables as backend/.env, different values.
POSTGRES_PASSWORD=change_me
COMMITAHEAD_MIGRATOR_PASSWORD=change_me
COMMITAHEAD_APP_PASSWORD=change_me

# Supabase Auth — the real project (see README.md "Setting Up the Real Supabase Project"). This
# stack's own Postgres stays local/self-hosted (docker-compose.prod.yml's db service); only Auth
# points at Supabase, same separation as development.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=change_me

# Optional — leave blank to run with AI analysis unconfigured (every AnalyzeX use case fails closed
# with a clear error, never a silent fallback). Never required for the app to start.
ANTHROPIC_API_KEY=

# Seeds/updates exactly one local PostgreSQL `users` row after migrations
# (backend/scripts/bootstrap-production-user.ps1) — closed login (ADR-0015) rejects every email
# until at least one enabled User row exists. This does NOT create a Supabase account or enable
# public signup: the Supabase Auth user with this exact id must already exist in the real project
# (README.md "Setting Up the Real Supabase Project"). INITIAL_USER_ID is that user's Supabase Auth
# UID (a GUID) — the seeded row uses the same value for both `id` and `supabase_user_id`, matching
# the existing real-Supabase seed example in README.md.
INITIAL_USER_ID=change_me
INITIAL_USER_EMAIL=change_me
