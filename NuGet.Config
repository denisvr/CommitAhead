<?xml version="1.0" encoding="utf-8"?>
<!--
  Declares the private Devalente.Shared feed without any credential. Credentials live only in the
  user-level NuGet configuration locally, and are injected into the ephemeral runner checkout in CI
  (`dotnet nuget update source devalente-shared`). NuGet matches stored credentials by source *name*,
  so the key below must stay exactly "devalente-shared".

  packageSourceMapping is a supply-chain control, not cosmetics: it pins the Devalente.Shared.*
  prefix to the private feed so a same-named package published on nuget.org can never be resolved in
  its place. <clear /> is required for the mapping to be deterministic, which is why nuget.org is
  redeclared explicitly here.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="devalente-shared" value="https://nuget.pkg.github.com/denisvr/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="devalente-shared">
      <package pattern="Devalente.Shared.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
